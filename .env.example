# ローカルDocker: 他のプロジェクト・worktreeと重複しない値を設定する
COMPOSE_PROJECT_NAME=manga-kura
WEB_PORT=17390
API_PORT=17391

# 通常は上記ポートから自動設定される。接続先を個別に変更する場合のみ指定する
# API_CORS_ORIGINS=http://127.0.0.1:17390,http://localhost:17390
# VITE_FETCH_API_BASE_URL=http://127.0.0.1:17391

# Secret: replace before starting Docker Compose
API_PROXY_TOKEN_SECRET=replace-with-a-long-random-secret
